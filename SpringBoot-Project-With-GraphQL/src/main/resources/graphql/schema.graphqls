type User{
    id:ID,
    name:String,
    email:String,
    phone:String,
    orders:[Order]
}

type Order{
    id:ID,
    orderDetail:String,
    price:Float,
    user:User
}
 type Mutation{
     createUser(name:String,email:String,phone:String):User
     deleteUser(userId:ID!):Boolean
     updateUser(
         id: ID!,
         name: String!,
         email: String!,
         phone: String!
     ): User

     createOrder(orderDetail:String,price:Float,userId:ID!):Order
     deleteOrder(orderId:ID!):Boolean
 }
 type Query{
     getAllUser:[User],
     getUser(userId:ID!):User,

     getAllOrder:[Order],
     getOrder(orderId:ID!):Order,



 }